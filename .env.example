# API Settings
PROJECT_NAME="CORE-AUTH"
API_V1_STR="/api/v1"

# Security
# Generate secrets: openssl rand -hex 32
ACCESS_TOKEN_SECRET_KEY="development_access_secret_do_not_use_in_prod"
REFRESH_TOKEN_SECRET_KEY="development_refresh_secret_do_not_use_in_prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=core_auth
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}/${POSTGRES_DB}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
